{
  "name": "northside-bozeman",
  "type": "module",
  "version": "0.0.1",
  "description": "Community site for Bozeman’s Northside / Historic Brewery District.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/encrypt-member-contacts.ts --optional && astro dev",
    "build": "node --experimental-strip-types scripts/encrypt-member-contacts.ts --optional && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "encrypt:member-contacts": "node --experimental-strip-types scripts/encrypt-member-contacts.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "astro-pagefind": "^2.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "wrangler": "^4.148.0"
  }
}
