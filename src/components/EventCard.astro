---
import type { CollectionEntry } from 'astro:content';
import { formatEventDate, isPastEvent } from '../utils/format-date';
import { isImageFile } from '../utils/events';

interface Props {
  event: CollectionEntry<'events'>;
  featured?: boolean;
}

const { event, featured = false } = Astro.props;
const past = isPastEvent(event.data.date);
const when = [formatEventDate(event.data.date), event.data.time].filter(Boolean).join(' · ');
const poster = event.data.artifacts.find(
  (artifact) => artifact.kind === 'poster' && isImageFile(artifact.file),
);
const kicker = past ? 'From the archive' : featured ? 'Featured event' : 'Neighborhood event';
---

<article class="flex h-full flex-col border border-line bg-surface">
  <div class={past ? 'h-1.5 bg-olive' : 'h-1.5 bg-rust'}></div>
  {
    poster && (
      <a href={`/events/${event.id}`} tabindex="-1" aria-hidden="true">
        <img
          src={poster.file}
          alt=""
          loading="lazy"
          class="aspect-[4/3] w-full border-b border-line object-cover"
        />
      </a>
    )
  }
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <p class:list={['text-xs uppercase tracking-[0.16em]', past ? 'text-olive' : 'text-rust']}>
      {kicker}
    </p>
    <p class="mt-3 text-sm text-muted">{when}</p>
    <h2 class="mt-1 font-serif text-2xl font-medium tracking-tight">
      <a class="underline-offset-4 hover:underline" href={`/events/${event.id}`}>
        {event.data.title}
      </a>
    </h2>
    <p class="mt-3 leading-relaxed">{event.data.summary}</p>
    <p class="mt-3 text-sm text-muted">{event.data.location}</p>
    <a
      class="mt-5 inline-flex text-sm font-semibold text-rust underline-offset-4 hover:underline"
      href={`/events/${event.id}`}
    >
      Event details
    </a>
  </div>
</article>
