---
import type { CollectionEntry } from 'astro:content';
import { formatEventDate, isPastEvent } from '../utils/format-date';

interface Props {
  event: CollectionEntry<'events'>;
  featured?: boolean;
}

const { event, featured = false } = Astro.props;
const past = isPastEvent(event.data.date);
const when = [formatEventDate(event.data.date), event.data.time].filter(Boolean).join(' · ');
---

<article class="flex h-full flex-col border border-line bg-surface">
  <div class="h-1.5 bg-rust"></div>
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <p class="text-xs uppercase tracking-[0.16em] text-rust">
      {featured ? 'Featured event' : 'Neighborhood event'}
      {past ? ' · Past' : ''}
    </p>
    <p class="mt-3 text-sm text-muted">{when}</p>
    <h2 class="mt-1 font-serif text-2xl font-medium tracking-tight">
      <a class="underline-offset-4 hover:underline" href={`/events/${event.id}`}>
        {event.data.title}
      </a>
    </h2>
    <p class="mt-3 leading-relaxed">{event.data.summary}</p>
    <p class="mt-3 text-sm text-muted">{event.data.location}</p>
    <a
      class="mt-5 inline-flex text-sm font-semibold text-rust underline-offset-4 hover:underline"
      href={`/events/${event.id}`}
    >
      Event details
    </a>
  </div>
</article>
