---
import DistrictLockup from './DistrictLockup.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;

const items = [
  { href: '/', label: 'Home' },
  { href: '/events', label: 'Events' },
  { href: '/map', label: 'Business Map ' },
  { href: '/about', label: 'About' },
];

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="border-b border-line bg-surface">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
  >
    <a href="/" class="flex items-center gap-3" aria-label="Northside Bozeman Business Group — home">
      <Logo variant="badge" alt="" class="h-auto w-16 sm:w-[4.5rem]" />
      <DistrictLockup />
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          items.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'text-sm underline-offset-4',
                    active
                      ? 'font-semibold text-rust underline'
                      : 'text-ink hover:text-rust hover:underline',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
  <div class="h-1 bg-rust"></div>
  <div class="h-px bg-ochre"></div>
</header>
