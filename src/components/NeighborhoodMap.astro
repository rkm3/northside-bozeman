---
import {
  boundaryCenter,
  northsideBoundaryNote,
  northsideBoundaryRing,
  northsideBoundaryStyle,
} from '../data/northside-boundary';
import { boundaryRingToPoints } from '../utils/boundary-svg';

const rawKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
const trimmed = typeof rawKey === 'string' ? rawKey.trim() : '';
const apiKey = /^[A-Za-z0-9_-]{10,}$/.test(trimmed) ? trimmed : '';
const sketchPoints = boundaryRingToPoints(northsideBoundaryRing);

const mapConfig = JSON.stringify({
  key: apiKey,
  boundaryRing: northsideBoundaryRing,
  boundaryStyle: northsideBoundaryStyle,
  center: boundaryCenter(northsideBoundaryRing),
}).replace(/</g, '\\u003c');
---

<div>
  {
    apiKey ? (
      <div
        id="neighborhood-map"
        class="h-80 border border-line bg-cream sm:h-[28rem]"
        role="region"
        aria-label="Northside neighborhood map"
      />
    ) : (
      <div class="border border-dashed border-line bg-cream px-4 py-8 sm:px-8">
        <div class="mx-auto max-w-md">
          <svg viewBox="0 0 320 200" class="h-auto w-full" role="img" aria-label="Approximate Northside boundary sketch">
            <rect width="320" height="200" fill="#f7f1e6" />
            <polygon
              points={sketchPoints}
              fill={northsideBoundaryStyle.fill}
              fill-opacity={northsideBoundaryStyle.fillOpacity}
              stroke={northsideBoundaryStyle.stroke}
              stroke-width="2"
            />
          </svg>
          <p class="mt-4 font-serif text-xl">Map view unavailable</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Add <code class="bg-paper px-1 py-0.5 text-ink">PUBLIC_GOOGLE_MAPS_API_KEY</code> to a
            <code class="bg-paper px-1 py-0.5 text-ink">.env</code> file and restart the dev server to
            load Google Maps. The site works without a key. The sketch above is the same placeholder
            outline the live map would draw.
          </p>
        </div>
      </div>
    )
  }

  <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <p class="flex items-center gap-2 text-sm text-ink">
      <span
        class="inline-block h-3 w-3 border border-brick bg-brick/40"
        aria-hidden="true"></span>
      Approximate Northside boundary
    </p>
  </div>
  <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted">{northsideBoundaryNote}</p>
</div>

{
  apiKey && (
    <>
      <script type="application/json" id="northside-map-config" set:html={mapConfig} />
      <script is:inline>
        (function () {
          var cfgEl = document.getElementById('northside-map-config');
          var el = document.getElementById('neighborhood-map');
          if (!cfgEl || !el) return;
          var cfg = JSON.parse(cfgEl.textContent || '{}');
          if (!cfg.key) return;

          function showMessage(title, body) {
            el.textContent = '';
            var wrap = document.createElement('div');
            wrap.className = 'p-5 text-sm';
            var heading = document.createElement('p');
            heading.className = 'font-serif text-lg text-ink';
            heading.textContent = title;
            var copy = document.createElement('p');
            copy.className = 'mt-2 leading-relaxed text-muted';
            copy.textContent = body;
            wrap.appendChild(heading);
            wrap.appendChild(copy);
            el.appendChild(wrap);
          }

          window.gm_authFailure = function () {
            showMessage(
              'Google Maps could not use this API key',
              'In Google Cloud Console, enable the Maps JavaScript API and billing, and allow this site origin under HTTP referrer restrictions. The browser console has the exact error.'
            );
          };

          var script = document.createElement('script');
          script.async = true;
          script.src =
            'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(cfg.key);
          script.onload = function () {
            var g = window.google;
            if (!g || !g.maps) {
              showMessage('Map failed to load', 'Google Maps did not initialize. Check the API key and the browser console.');
              return;
            }
            var map = new g.maps.Map(el, {
              center: cfg.center || { lat: 45.687, lng: -111.031 },
              zoom: 15,
              mapTypeControl: false,
              streetViewControl: false,
              fullscreenControl: false,
              styles: [
                { featureType: 'all', elementType: 'all', stylers: [{ saturation: -100 }, { gamma: 0.98 }] },
                { featureType: 'poi', stylers: [{ visibility: 'off' }] },
                { featureType: 'transit', stylers: [{ visibility: 'off' }] },
              ],
            });
            var style = cfg.boundaryStyle || {};
            var polygon = new g.maps.Polygon({
              paths: cfg.boundaryRing,
              strokeColor: style.stroke || '#8d3b28',
              strokeOpacity: style.strokeOpacity == null ? 0.95 : style.strokeOpacity,
              strokeWeight: 2,
              fillColor: style.fill || '#c4784a',
              fillOpacity: style.fillOpacity == null ? 0.38 : style.fillOpacity,
              clickable: false,
            });
            polygon.setMap(map);
            if (cfg.boundaryRing && cfg.boundaryRing.length) {
              var bounds = new g.maps.LatLngBounds();
              cfg.boundaryRing.forEach(function (point) {
                bounds.extend(point);
              });
              map.fitBounds(bounds, 48);
            }
          };
          script.onerror = function () {
            showMessage(
              'Map failed to load',
              'The Maps JavaScript API script did not load. Check the network connection and that the key is allowed to call that API.'
            );
          };
          document.head.appendChild(script);
        })();
      </script>
    </>
  )
}
