---
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import {
  boundaryCenter,
  northsideBoundaryRing,
  northsideBoundaryStyle,
} from '../data/northside-boundary';
import {
  PLACE_CATEGORIES,
  formatCategoryLabels,
  placeCategoryLabels,
  placeCategoryMarker,
  primaryCategory,
} from '../data/place-categories';
import { boundaryRingToPoints } from '../utils/boundary-svg';
import LinkPill from './LinkPill.astro';
import { isLogoCover } from '../utils/place-image';
import { omitPrivateFields } from '../utils/omit-private-fields';
import { isListedPlace } from '../utils/place-status';
import { getGoogleMapsApiKey } from '../utils/google-maps-key';
import { getWebsiteLabel } from '../utils/website-label';

const places = (await getCollection('places'))
  .filter(isListedPlace)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const apiKey = getGoogleMapsApiKey();
const sketchPoints = boundaryRingToPoints(northsideBoundaryRing);

const presentCategories = PLACE_CATEGORIES.filter((category) =>
  places.some((place) => place.data.categories.includes(category)),
);

const points = await Promise.all(places.map(async (place) => {
  // Never ship private_* frontmatter into client map JSON.
  const publicData = omitPrivateFields(place.data);
  const primary = primaryCategory(publicData.categories);
  const marker = placeCategoryMarker[primary];
  const website = publicData.website;
  const cover = publicData.cover;
  const isLogo = cover ? isLogoCover(cover) : false;
  // Popup is 220px square for logos, ~320px wide for photos; sized for 2x screens.
  const popupCover = cover ? await getImage({ src: cover, width: isLogo ? 440 : 640 }) : undefined;
  return {
    name: publicData.name,
    lat: publicData.lat,
    lng: publicData.lng,
    slug: place.id,
    categories: [...publicData.categories],
    categoryLabel: formatCategoryLabels(publicData.categories),
    address: publicData.address,
    phone: publicData.phone,
    email: publicData.email,
    fill: marker.fill,
    stroke: marker.stroke,
    coverSrc: popupCover?.src,
    coverSquare: isLogo,
    placeHref: `/places/${place.id}`,
    website,
    websiteLabel: website ? getWebsiteLabel(website) : undefined,
  };
}));

const mapConfig = JSON.stringify({
  key: apiKey,
  points,
  categoryLegend: presentCategories.map((id) => ({
    id,
    label: placeCategoryLabels[id],
    fill: placeCategoryMarker[id].fill,
  })),
  boundaryRing: northsideBoundaryRing,
  boundaryStyle: northsideBoundaryStyle,
  center: boundaryCenter(northsideBoundaryRing),
}).replace(/</g, '\\u003c');
---

<style is:global>
  #neighborhood-map .gm-style-iw-c,
  #neighborhood-map .gm-style-iw-chr {
    max-height: min(75vh, 520px) !important;
  }
  #neighborhood-map .gm-style-iw-d {
    max-height: min(72vh, 500px) !important;
    overflow: auto !important;
  }
</style>
<style>
  .place-filter {
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink);
  }
  .place-filter[aria-pressed='true'] {
    border-color: var(--color-rust);
    background: var(--color-rust);
    color: var(--color-surface);
  }
  .legend-item.is-dim {
    opacity: 0.35;
  }
</style>

<div>
  <div
    id="place-filters"
    class="flex flex-wrap gap-2"
    role="group"
    aria-label="Place categories"
  >
    <button type="button" class="place-filter rounded-full px-3 py-1 text-sm" data-category="" aria-pressed="true">
      All
    </button>
    {
      presentCategories.map((category) => (
        <button
          type="button"
          class="place-filter rounded-full px-3 py-1 text-sm"
          data-category={category}
          aria-pressed="false"
        >
          {placeCategoryLabels[category]}
        </button>
      ))
    }
  </div>

  <div class="mt-4">
    {
      apiKey ? (
        <div
          id="neighborhood-map"
          class="h-96 border border-line bg-surface sm:h-[32rem]"
          role="region"
          aria-label="Northside neighborhood map"
        />
      ) : (
        <div class="border border-dashed border-line bg-surface px-4 py-8 sm:px-8">
          <div class="mx-auto max-w-md">
            <svg viewBox="0 0 320 200" class="h-auto w-full" role="img" aria-label="Approximate Northside boundary sketch">
              <rect width="320" height="200" fill="var(--color-paper)" />
              <polygon
                points={sketchPoints}
                fill={northsideBoundaryStyle.fill}
                fill-opacity={northsideBoundaryStyle.fillOpacity}
                stroke={northsideBoundaryStyle.stroke}
                stroke-width="2"
              />
            </svg>
            <p class="mt-4 font-serif text-xl">Map view unavailable</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              Add <code class="bg-paper px-1 py-0.5 text-ink">PUBLIC_GOOGLE_MAPS_API_KEY</code> to a
              <code class="bg-paper px-1 py-0.5 text-ink">.env</code> file and restart the dev server to
              load Google Maps. The places below stay available either way.
            </p>
          </div>
        </div>
      )
    }
  </div>

  <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div id="place-legend" class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink" aria-label="Map pin categories">
      {
        presentCategories.map((category) => (
          <span class="legend-item inline-flex items-center gap-1.5" data-legend-cat={category}>
            <span
              class="inline-block h-3 w-3 rounded-full border border-white"
              style={{ backgroundColor: placeCategoryMarker[category].fill }}
              aria-hidden="true"
            />
            {placeCategoryLabels[category]}
          </span>
        ))
      }
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-block h-3 w-3 border border-rust bg-rust/40" aria-hidden="true" />
        Approximate Northside boundary
      </span>
      <span id="you-legend" class="hidden">
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 rounded-full border-2 border-ochre bg-ink" aria-hidden="true" />
          You
        </span>
      </span>
    </div>
    {
      apiKey && (
        <div class="shrink-0">
          <button
            id="show-me-on-map"
            type="button"
            class="border border-rust bg-surface px-3 py-2 text-sm font-semibold text-rust hover:bg-rust hover:text-surface disabled:opacity-60"
          >
            Show me on the map
          </button>
          <p id="show-me-status" class="mt-2 max-w-xs text-sm text-muted" role="status" />
        </div>
      )
    }
  </div>

  <h2 class="mt-10 font-serif text-2xl font-medium">Places on this map</h2>
  <ul id="place-list" class="mt-4 grid gap-4 sm:grid-cols-2">
    {
      places.map((place) => {
        const cover = place.data.cover;
        const isLogo = cover ? isLogoCover(cover) : false;
        const website = place.data.website;
        const instagramHandles = place.data.instagram_handle ?? [];
        const threadsHandle = place.data.threads_handle;
        const pinterestHandle = place.data.pinterest_handle;
        return (
          <li class="h-full" data-categories={place.data.categories.join(',')}>
            <div class="relative flex h-full flex-col overflow-hidden border border-line bg-surface hover:border-rust">
              {!cover && (
                <span
                  class="flex aspect-[3/2] w-full items-center justify-center border-b border-line bg-paper font-serif text-7xl font-medium text-olive/30"
                  aria-hidden="true"
                >
                  {place.data.name.replace(/^the\s+/i, '').charAt(0).toUpperCase()}
                </span>
              )}
              {cover && (
                <Image
                  src={cover}
                  alt=""
                  widths={[480, 640, 960]}
                  sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 50vw, 100vw"
                  class:list={[
                    'w-full',
                    isLogo ? 'aspect-square object-contain' : 'aspect-[3/2] object-cover',
                  ]}
                />
              )}
              <span class="flex flex-1 flex-col p-4">
                <span class="text-xs uppercase tracking-[0.14em] text-rust">
                  {formatCategoryLabels(place.data.categories)}
                </span>
                <a href={`/places/${place.id}`} class="mt-1 font-serif text-xl after:absolute after:inset-0">
                  {place.data.name}
                </a>
                <a
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.data.address)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-map-focus={place.id}
                  class="relative z-10 mt-1 self-start text-sm text-muted underline decoration-line underline-offset-4 hover:text-rust hover:decoration-rust"
                >
                  {place.data.address}
                </a>
                {(website || instagramHandles.length > 0 || threadsHandle || pinterestHandle) && (
                  <span class="relative z-10 mt-3 flex flex-wrap gap-2">
                    {website && <LinkPill kind="website" url={website} />}
                    {instagramHandles.map((handle) => (
                      <LinkPill kind="instagram" handle={handle} />
                    ))}
                    {threadsHandle && <LinkPill kind="threads" handle={threadsHandle} />}
                    {pinterestHandle && <LinkPill kind="pinterest" handle={pinterestHandle} />}
                  </span>
                )}
              </span>
            </div>
          </li>
        );
      })
    }
  </ul>
  <p id="place-filter-empty" class="mt-6 hidden text-sm text-muted">No places in this category.</p>
</div>

<script type="application/json" id="northside-map-config" set:html={mapConfig} />
<script>
  import { mountNeighborhoodMap, type NeighborhoodMapConfig } from '../scripts/neighborhood-map';

  const configElement = document.getElementById('northside-map-config');
  if (configElement?.textContent) {
    const config = JSON.parse(configElement.textContent) as NeighborhoodMapConfig;
    mountNeighborhoodMap(config);
  }
</script>
