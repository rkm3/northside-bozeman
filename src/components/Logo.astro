---
import type { LogoVariant } from '../data/brand';

interface Props {
  variant: LogoVariant;
  class?: string;
  /** Pass `""` when a visible label or heading already names the brand. */
  alt?: string;
  loading?: 'eager' | 'lazy';
}

const logos: Record<LogoVariant, { src: string; width: number; height: number }> = {
  primary: { src: '/brand/northside-bozeman-logo-primary.svg', width: 1279, height: 1138 },
  badge: { src: '/brand/northside-bozeman-logo-badge.svg', width: 1377, height: 1365 },
  icon: { src: '/brand/northside-bozeman-icon.svg', width: 214, height: 215 },
};

const {
  variant,
  class: className,
  alt = 'Northside Bozeman Business Group',
  loading = 'eager',
} = Astro.props;
const logo = logos[variant];
---

<img
  src={logo.src}
  width={logo.width}
  height={logo.height}
  alt={alt}
  loading={loading}
  decoding="async"
  class:list={['block', className]}
/>
