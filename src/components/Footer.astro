---
import DistrictLockup from './DistrictLockup.astro';
import Logo from './Logo.astro';

const links = [
  { href: '/about', label: 'About' },
  { href: '/events', label: 'Events' },
  { href: '/map', label: 'Business Map ' },
  { href: '/contact', label: 'Contact' },
  { href: '/brand', label: 'Brand guidelines' },
  { href: '/add-a-business', label: 'Add a business' },
];
---

<footer class="mt-20 bg-ink text-surface">
  <div class="mx-auto grid max-w-5xl gap-10 px-4 py-12 sm:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <Logo variant="icon" alt="" loading="lazy" class="h-auto w-12" />
        <DistrictLockup tone="light" />
      </div>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-surface/80">
        From Lager to Legacy in Bozeman, Montana. A neighborhood association for the Historic
        Brewery District.
      </p>
    </div>
    <div>
      <p class="text-xs uppercase tracking-[0.18em] text-surface/70">Visit</p>
      <p class="mt-3 text-sm leading-relaxed">
        Historic Brewery District<br />
        Northeast Bozeman, Montana
      </p>
    </div>
    <nav aria-label="Footer">
      <p class="text-xs uppercase tracking-[0.18em] text-surface/70">On this site</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          links.map((link) => (
            <li>
              <a class="underline-offset-4 hover:underline" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
