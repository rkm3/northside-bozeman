---
interface Props {
  tone?: 'ink' | 'light';
}

const { tone = 'ink' } = Astro.props;
const onDark = tone === 'light';
---

<span class="inline-flex max-w-full flex-col">
  <span
    class:list={[
      'font-serif text-2xl font-semibold leading-[0.95]',
      onDark ? 'text-surface' : 'text-rust',
    ]}
  >
    Northside Bozeman
  </span>
  <span
    class:list={[
      'mt-1.5 text-xs font-semibold uppercase leading-none tracking-[0.22em]',
      onDark ? 'text-ochre' : 'text-olive',
    ]}
  >
    Business Group
  </span>
</span>
