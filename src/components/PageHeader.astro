---
interface Props {
  kicker?: string;
  title: string;
  lede?: string;
}

const { kicker, title, lede } = Astro.props;
---

<header class="mx-auto max-w-5xl px-4 pb-2 pt-12 sm:pt-16">
  {kicker && <p class="text-xs uppercase tracking-[0.18em] text-rust">{kicker}</p>}
  <h1 class="mt-2 max-w-3xl font-serif text-4xl font-medium tracking-tight sm:text-5xl">
    {title}
  </h1>
  {lede && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{lede}</p>}
</header>
