---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  aboutArchiveImages,
  aboutHeroImage,
  aboutSectionImages,
} from '../data/about-images';

const sections = (
  await Promise.all(
    (await getCollection('pages', ({ data }) => data.section === 'about'))
      .sort((a, b) => a.data.order - b.data.order)
      .map(async (section) => {
        const { Content } = await render(section);
        return { section, Content, image: aboutSectionImages[section.id] };
      }),
  )
);
---

<BaseLayout
  title="About"
  description="Who we are, what we do, and why we do it — the Northside Neighborhood group in Bozeman’s Historic Brewery District."
>
  <PageHeader
    kicker="About the association"
    title="Who, what, and why"
    lede="A neighborhood association for artists, artisans, and local businesses on Bozeman’s Northside."
  />

  <figure class="mx-auto max-w-5xl px-4 pt-6">
    <Image
      src={aboutHeroImage.src}
      alt={aboutHeroImage.alt}
      widths={[768, 1200, 1600]}
      sizes="(min-width: 64rem) 64rem, 100vw"
      loading="eager"
      class="aspect-[16/9] w-full object-cover"
    />
    <figcaption class="mt-2 text-sm text-muted">
      {aboutHeroImage.caption}
    </figcaption>
  </figure>

  <div class="mx-auto max-w-5xl px-4 pb-4">
    <ol class="mt-6 divide-y divide-line border-y border-line">
      {
        sections.map(({ section, Content, image }, index) => (
          <li id={section.id} class="grid gap-6 py-10 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8">
            <p class="text-xs uppercase tracking-[0.16em] text-rust">
              {String(index + 1).padStart(2, '0')}
            </p>
            <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,18rem)] lg:items-start lg:gap-10">
              <div>
                <h2 class="font-serif text-3xl font-medium tracking-tight">{section.data.title}</h2>
                <div class="prose-local mt-4 max-w-2xl text-lg leading-relaxed">
                  <Content />
                </div>
              </div>
              {image && (
                <Image
                  src={image.src}
                  alt={image.alt}
                  widths={[384, 640, 960]}
                  sizes="(min-width: 64rem) 18rem, (min-width: 40rem) 50vw, 100vw"
                  class="aspect-square w-full object-cover"
                />
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <section class="mx-auto max-w-5xl px-4 pb-16 pt-8" aria-labelledby="from-the-block">
    <h2 id="from-the-block" class="font-serif text-3xl font-medium tracking-tight">From the block</h2>
    <p class="mt-3 max-w-2xl text-muted">
      Scenes from neighborhood life and the district’s rail-and-brewery past.
    </p>
    <ul class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        aboutArchiveImages.map((image) => (
          <li>
            <Image
              src={image.src}
              alt={image.alt}
              widths={[384, 640, 960]}
              sizes="(min-width: 40rem) 33vw, 100vw"
              class="aspect-[4/3] w-full object-cover"
            />
            {image.credit && <p class="mt-2 text-xs text-muted">{image.credit}</p>}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
