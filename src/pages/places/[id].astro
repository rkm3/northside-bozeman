---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import LinkPill from '../../components/LinkPill.astro';
import { formatCategoryLabels } from '../../data/place-categories';
import { isLogoCover } from '../../utils/place-image';
import { isPlacePageBuilt } from '../../utils/place-status';
import { googleMapsPlaceUrl } from '../../utils/google-maps-url';
import { getWebsiteLabel } from '../../utils/website-label';

export async function getStaticPaths() {
  const places = await getCollection('places');
  return places.filter(isPlacePageBuilt).map((place) => ({
    params: { id: place.id },
    props: { place },
  }));
}

const { place } = Astro.props;
const { Content } = await render(place);
const cover = place.data.cover;
const isLogo = cover ? isLogoCover(cover) : false;
const website = place.data.website;
const instagramHandles = place.data.instagram_handle ?? [];
const threadsHandle = place.data.threads_handle;
const pinterestHandle = place.data.pinterest_handle;
const isArchived = place.data.status === 'archived';
const isDraft = place.data.status === 'draft';
const successor = place.data.successor
  ? await getEntry('places', place.data.successor)
  : undefined;
const kicker = isArchived
  ? 'Former business'
  : isDraft
    ? `Draft · ${formatCategoryLabels(place.data.categories)}`
    : formatCategoryLabels(place.data.categories);
const mapsUrl = googleMapsPlaceUrl({
  name: place.data.name,
  address: place.data.address,
  googlePlaceId: place.data.google_place_id,
});
---

<BaseLayout
  title={place.data.name}
  description={
    isArchived
      ? `${place.data.name} was a Northside Bozeman business. ${place.data.address}`
      : `${place.data.name} on Bozeman’s Northside. ${place.data.address}`
  }
>
  <PageHeader kicker={kicker} title={place.data.name} />

  <article class="mx-auto max-w-5xl px-4 py-6" data-pagefind-filter="type:place">
    {
      isArchived && (
        <p class="mb-8 max-w-2xl border border-line bg-surface px-5 py-4 text-base leading-relaxed">
          This listing is archived
          {successor ? (
            <>
              {' '}
              — the shop continues as{' '}
              <a
                class="font-semibold text-rust underline-offset-4 hover:underline"
                href={`/places/${successor.id}`}
              >
                {successor.data.name}
              </a>
              .
            </>
          ) : (
            '.'
          )}
        </p>
      )
    }
    {
      isDraft && (
        <p class="mb-8 max-w-2xl border border-line bg-surface px-5 py-4 text-base leading-relaxed text-muted">
          Draft listing — visible in local/preview builds only, not on the public map yet.
        </p>
      )
    }
    {
      cover && (
        <Image
          src={cover}
          alt={place.data.name}
          widths={isLogo ? [384, 768] : [768, 1200, 1536]}
          sizes={isLogo ? '(min-width: 24rem) 24rem, 100vw' : '(min-width: 48rem) 48rem, 100vw'}
          loading="eager"
          class:list={[
            'mb-8 w-full border border-line',
            isLogo
              ? 'aspect-square max-w-sm object-contain'
              : 'aspect-[3/2] max-w-3xl object-cover',
          ]}
        />
      )
    }

    <dl class="grid max-w-2xl gap-4 border border-line bg-surface p-5 sm:grid-cols-2">
      <div>
        <dt class="text-xs uppercase tracking-[0.16em] text-muted">Address</dt>
        <dd class="mt-1">{place.data.address}</dd>
        <dd class="mt-3">
          <a
            class="inline-flex items-center gap-2 text-sm font-semibold text-rust underline-offset-4 hover:underline"
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"
              ></path>
            </svg>
            Open in Google Maps
          </a>
        </dd>
      </div>
      {
        (website || place.data.phone || place.data.email) && (
          <div>
            <dt class="text-xs uppercase tracking-[0.16em] text-muted">Contact</dt>
            {website && (
              <dd class="mt-1">
                <a
                  class="font-semibold text-rust underline-offset-4 hover:underline"
                  href={website}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {getWebsiteLabel(website)}
                </a>
              </dd>
            )}
            {place.data.phone && (
              <dd class="mt-1">
                <a class="text-rust underline-offset-4 hover:underline" href={`tel:${place.data.phone.replace(/[^\d+]/g, '')}`}>
                  {place.data.phone}
                </a>
              </dd>
            )}
            {place.data.email && (
              <dd class="mt-1">
                <a class="text-rust underline-offset-4 hover:underline" href={`mailto:${place.data.email}`}>
                  {place.data.email}
                </a>
              </dd>
            )}
          </div>
        )
      }
      {
        (instagramHandles.length > 0 || threadsHandle || pinterestHandle) && (
          <div class="sm:col-span-2">
            <dt class="text-xs uppercase tracking-[0.16em] text-muted">Social</dt>
            <dd class="mt-2 flex flex-wrap gap-2">
              {instagramHandles.map((handle) => (
                <LinkPill kind="instagram" handle={handle} />
              ))}
              {threadsHandle && <LinkPill kind="threads" handle={threadsHandle} />}
              {pinterestHandle && <LinkPill kind="pinterest" handle={pinterestHandle} />}
            </dd>
          </div>
        )
      }
    </dl>

    <div class="prose-local mt-8 max-w-2xl text-lg leading-relaxed">
      <Content />
    </div>

    <p class="mt-8">
      <a class="text-sm font-semibold text-rust underline-offset-4 hover:underline" href="/map">
        Neighborhood map
      </a>
    </p>
  </article>
</BaseLayout>
