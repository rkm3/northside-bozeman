---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import LinkPill from '../../components/LinkPill.astro';
import { formatCategoryLabels } from '../../data/place-categories';
import { isLogoCover } from '../../utils/place-image';
import { getWebsiteLabel } from '../../utils/website-label';

export async function getStaticPaths() {
  const places = await getCollection('places');
  return places.map((place) => ({
    params: { id: place.id },
    props: { place },
  }));
}

const { place } = Astro.props;
const { Content } = await render(place);
const cover = place.data.cover;
const isLogo = cover ? isLogoCover(cover) : false;
const website = place.data.website;
const instagramHandles = place.data.instagram_handle ?? [];
const pinterestHandle = place.data.pinterest_handle;
---

<BaseLayout
  title={place.data.name}
  description={`${place.data.name} on Bozeman’s Northside. ${place.data.address}`}
>
  <PageHeader kicker={formatCategoryLabels(place.data.categories)} title={place.data.name} />

  <article class="mx-auto max-w-5xl px-4 py-6">
    {
      cover && (
        <Image
          src={cover}
          alt={place.data.name}
          widths={isLogo ? [384, 768] : [768, 1200, 1536]}
          sizes={isLogo ? '(min-width: 24rem) 24rem, 100vw' : '(min-width: 48rem) 48rem, 100vw'}
          loading="eager"
          class:list={[
            'mb-8 w-full border border-line',
            isLogo
              ? 'aspect-square max-w-sm object-contain'
              : 'aspect-[3/2] max-w-3xl object-cover',
          ]}
        />
      )
    }

    <dl class="grid max-w-2xl gap-4 border border-line bg-surface p-5 sm:grid-cols-2">
      <div>
        <dt class="text-xs uppercase tracking-[0.16em] text-muted">Address</dt>
        <dd class="mt-1">{place.data.address}</dd>
      </div>
      {
        (website || place.data.phone || place.data.email) && (
          <div>
            <dt class="text-xs uppercase tracking-[0.16em] text-muted">Contact</dt>
            {website && (
              <dd class="mt-1">
                <a
                  class="font-semibold text-rust underline-offset-4 hover:underline"
                  href={website}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {getWebsiteLabel(website)}
                </a>
              </dd>
            )}
            {place.data.phone && (
              <dd class="mt-1">
                <a class="text-rust underline-offset-4 hover:underline" href={`tel:${place.data.phone.replace(/[^\d+]/g, '')}`}>
                  {place.data.phone}
                </a>
              </dd>
            )}
            {place.data.email && (
              <dd class="mt-1">
                <a class="text-rust underline-offset-4 hover:underline" href={`mailto:${place.data.email}`}>
                  {place.data.email}
                </a>
              </dd>
            )}
          </div>
        )
      }
      {
        (instagramHandles.length > 0 || pinterestHandle) && (
          <div class="sm:col-span-2">
            <dt class="text-xs uppercase tracking-[0.16em] text-muted">Social</dt>
            <dd class="mt-2 flex flex-wrap gap-2">
              {instagramHandles.map((handle) => (
                <LinkPill kind="instagram" handle={handle} />
              ))}
              {pinterestHandle && <LinkPill kind="pinterest" handle={pinterestHandle} />}
            </dd>
          </div>
        )
      }
    </dl>

    <div class="prose-local mt-8 max-w-2xl text-lg leading-relaxed">
      <Content />
    </div>

    <p class="mt-8">
      <a class="text-sm font-semibold text-rust underline-offset-4 hover:underline" href="/map">
        Neighborhood map
      </a>
    </p>
  </article>
</BaseLayout>
