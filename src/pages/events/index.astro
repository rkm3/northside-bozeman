---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventCard from '../../components/EventCard.astro';
import { splitEvents } from '../../utils/events';

const { upcoming, past } = splitEvents(await getCollection('events'));
---

<BaseLayout
  title="Events"
  description="Neighborhood events on Bozeman’s Northside, including the Northside Summer and Winter Strolls."
>
  <PageHeader
    kicker="Calendar"
    title="Events"
    lede="Gatherings for the Historic Brewery District, from the summer and winter strolls to whatever the block dreams up next."
  />

  <section class="mx-auto max-w-5xl px-4 py-8" aria-labelledby="upcoming">
    <p class="text-xs uppercase tracking-[0.16em] text-rust">01</p>
    <h2 id="upcoming" class="mt-2 font-serif text-3xl font-medium tracking-tight">Upcoming</h2>
    {
      upcoming.length === 0 ? (
        <p class="mt-6 max-w-xl border border-dashed border-line bg-surface p-6 text-muted">
          No events are on the calendar yet. When the association sets the next stroll, it will show up here.
        </p>
      ) : (
        <ul class="mt-6 grid gap-6 md:grid-cols-2">
          {upcoming.map((event) => (
            <li>
              <EventCard event={event} featured={event.data.featured} />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    past.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 py-12" aria-labelledby="archive">
        <p class="text-xs uppercase tracking-[0.16em] text-rust">02</p>
        <h2 id="archive" class="mt-2 font-serif text-3xl font-medium tracking-tight">Archive</h2>
        <p class="mt-3 max-w-2xl text-muted">
          Past strolls and gatherings, with the posters, maps, and photos we kept from each one.
        </p>
        <ul class="mt-6 grid gap-6 md:grid-cols-2">
          {past.map((event) => (
            <li>
              <EventCard event={event} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
