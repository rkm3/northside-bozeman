---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventCard from '../../components/EventCard.astro';

const events = (await getCollection('events')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="Events"
  description="Neighborhood events on Bozeman’s Northside, including the Northside Summer Stroll."
>
  <PageHeader
    kicker="Calendar"
    title="Events"
    lede="Gatherings for the Historic Brewery District, starting with the Northside Summer Stroll."
  />

  <div class="mx-auto max-w-5xl px-4 py-8">
    {
      events.length === 0 ? (
        <p class="max-w-xl border border-dashed border-line bg-cream p-6 text-muted">
          No events are on the calendar yet. When the association sets the next stroll, it will show up here.
        </p>
      ) : (
        <ul class="grid gap-6 md:grid-cols-2">
          {events.map((event) => (
            <li>
              <EventCard event={event} featured={event.data.featured} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
