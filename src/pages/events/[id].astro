---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { formatEventDate, isPastEvent } from '../../utils/format-date';
import { isImageFile } from '../../utils/events';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const past = isPastEvent(event.data.date);
const { artifacts } = event.data;
---

<BaseLayout title={event.data.title} description={event.data.summary}>
  <PageHeader
    kicker={past ? 'Past event' : 'Neighborhood event'}
    title={event.data.title}
    lede={event.data.summary}
  />

  <article class="mx-auto max-w-5xl px-4 py-6">
    <dl class="grid max-w-2xl gap-4 border border-line bg-surface p-5 sm:grid-cols-2">
      <div>
        <dt class="text-xs uppercase tracking-[0.16em] text-muted">When</dt>
        <dd class="mt-1">{formatEventDate(event.data.date)}</dd>
        {event.data.time && <dd class="text-sm text-muted">{event.data.time}</dd>}
      </div>
      <div>
        <dt class="text-xs uppercase tracking-[0.16em] text-muted">Where</dt>
        <dd class="mt-1">{event.data.location}</dd>
      </div>
    </dl>

    <div class="prose-local mt-8 max-w-2xl text-lg leading-relaxed">
      <Content />
    </div>

    {
      artifacts.length > 0 && (
        <section class="mt-12" aria-labelledby="artifacts">
          <h2 id="artifacts" class="font-serif text-2xl font-medium tracking-tight">
            {past ? 'From the archive' : 'Posters & maps'}
          </h2>
          <ul class="mt-6 grid items-start gap-6 sm:grid-cols-2 md:grid-cols-3">
            {artifacts.map((artifact) => (
              <li class="flex flex-col border border-line bg-surface">
                {isImageFile(artifact.file) && (
                  <a href={artifact.file}>
                    <img
                      src={artifact.file}
                      alt={artifact.title}
                      loading="lazy"
                      class="h-auto w-full border-b border-line"
                    />
                  </a>
                )}
                <div class="p-4">
                  <p class="text-xs uppercase tracking-[0.16em] text-olive">{artifact.kind}</p>
                  <a
                    class="mt-1 block font-semibold text-rust underline-offset-4 hover:underline"
                    href={artifact.file}
                  >
                    {artifact.title}
                  </a>
                  {artifact.credit && <p class="mt-1 text-sm text-muted">{artifact.credit}</p>}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="mt-8">
      <a class="text-sm font-semibold text-rust underline-offset-4 hover:underline" href="/events">
        All events
      </a>
    </p>
  </article>
</BaseLayout>
