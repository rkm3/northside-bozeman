---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DistrictLockup from '../components/DistrictLockup.astro';
import EventCard from '../components/EventCard.astro';
import MiniMap from '../components/MiniMap.astro';
import { aboutSectionImages } from '../data/about-images';
import { pickSpotlightEvent } from '../utils/events';

const district = await getEntry('pages', 'district');
const districtContent = district ? await render(district) : null;
const DistrictBody = districtContent?.Content;

const about = (await getCollection('pages', ({ data }) => data.section === 'about'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((section) => ({
    section,
    image: aboutSectionImages[section.id],
  }));

const featured = pickSpotlightEvent(await getCollection('events'));
---

<BaseLayout
  title="Northside Neighborhood"
  description="From Lager to Legacy in Bozeman MT. The Northside Neighborhood group for the Historic Brewery District."
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-4 py-12 md:py-16">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-rust">Bozeman, Montana</p>
        <h1 class="mt-4">
          <DistrictLockup size="display" />
        </h1>
        <p class="mt-5 font-serif text-2xl italic leading-snug text-olive sm:text-3xl">
          From Lager to Legacy in Bozeman MT
        </p>
        {
          DistrictBody && (
            <div class="prose-local mt-6 max-w-2xl text-lg leading-relaxed">
              <DistrictBody />
            </div>
          )
        }
      </div>

      <div class="mt-10 grid items-start gap-8 md:grid-cols-2">
        <MiniMap />
        {featured && <EventCard event={featured} featured />}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14" aria-labelledby="who-what-why">
    <h2 id="who-what-why" class="font-serif text-3xl font-medium tracking-tight">
      Who, what, and why
    </h2>
    <p class="mt-3 max-w-2xl text-muted">
      Artists and makers, the work of the block, and a reason to keep it local.
    </p>
    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {
        about.map(({ section, image }, index) => (
          <li class="flex flex-col border-t-2 border-rust bg-surface">
            {image && (
              <Image
                src={image.src}
                alt={image.alt}
                widths={[384, 640, 960]}
                sizes="(min-width: 48rem) 33vw, 100vw"
                class="aspect-[4/3] w-full object-cover"
              />
            )}
            <div class="flex flex-1 flex-col p-5">
              <p class="text-xs uppercase tracking-[0.16em] text-rust">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-2 font-serif text-2xl font-medium">{section.data.title}</h3>
              <p class="mt-3 text-sm leading-relaxed">{section.data.summary}</p>
              <a
                class="mt-4 inline-flex text-sm font-semibold text-rust underline-offset-4 hover:underline"
                href={`/about#${section.id}`}
              >
                Read {section.data.title}
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
