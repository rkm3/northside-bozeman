---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/events', label: 'Events' },
  { href: '/map', label: 'Business Map ' },
  { href: '/contact', label: 'Contact' },
];
---

<BaseLayout
  title="Page not found"
  description="That page is not on the Northside Neighborhood site."
  indexable={false}
>
  <PageHeader
    kicker="404"
    title="That page is not on the block"
    lede="The address does not match a page on this site. Try one of the neighborhood pages below."
  />

  <div class="mx-auto max-w-5xl px-4 py-8">
    <ul class="flex flex-wrap gap-x-5 gap-y-3">
      {
        links.map((link) => (
          <li>
            <a class="font-semibold text-rust underline-offset-4 hover:underline" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
