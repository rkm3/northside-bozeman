---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import NeighborhoodMap from '../components/NeighborhoodMap.astro';
---

<BaseLayout
  title="Business Map "
  description="Businesses and studios on Bozeman’s Northside, with a way to show your location on the neighborhood map."
>
  <PageHeader
    kicker="The block"
    title="Neighborhood map"
    lede="Shops, studios, and gathering spots in the Historic Brewery District. Parks stay off this map. Show me on the map drops a pin where you are."
  />

  <div class="mx-auto max-w-5xl px-4 py-8">
    <NeighborhoodMap />
  </div>
</BaseLayout>
