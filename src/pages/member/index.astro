---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const tools = [
  {
    href: '/member/brand',
    title: 'Brand guidelines',
    description: 'Logos, colors, type, and how to use the Northside mark.',
  },
  {
    href: '/member/add-a-business',
    title: 'Add a business',
    description: 'Fields, images, and the checklist for listing a Northside business.',
  },
  {
    href: '/member/contacts',
    title: 'Member contacts',
    description: 'Private contact list for the business group. Shared password required.',
  },
];
---

<BaseLayout
  title="Members"
  description="Tools for Northside Bozeman business group members: brand, listings, and contacts."
>
  <PageHeader
    kicker="Business group"
    title="Members"
    lede="Resources for people in the Northside Bozeman Business Group—brand assets, how to add a listing, and the member contact directory."
  />

  <div class="mx-auto max-w-5xl px-4 py-8">
    <ul class="max-w-2xl divide-y divide-line border border-line bg-surface">
      {
        tools.map((tool) => (
          <li>
            <a
              class="block px-5 py-5 no-underline transition-colors hover:bg-paper"
              href={tool.href}
            >
              <span class="font-serif text-2xl font-medium text-rust underline-offset-4 hover:underline">
                {tool.title}
              </span>
              <span class="mt-1 block text-sm leading-relaxed text-muted">{tool.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
