---
import '../styles/global.css';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brandColors } from '../data/brand';

interface Props {
  title: string;
  description: string;
  /** When false, omit from the Pagefind search index (member tools, 404, etc.). */
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props;
const fullTitle =
  title === 'Northside Neighborhood' ? title : `${title} · Northside Neighborhood`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={brandColors.rust} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <PagefindConfig />
  </head>
  <body class="min-h-screen antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <pagefind-modal reset-on-close></pagefind-modal>
    <main id="main" data-pagefind-body={indexable ? '' : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
