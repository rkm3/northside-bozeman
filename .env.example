# Maps JavaScript API key. The site builds and runs without this.
# Enable the Maps JavaScript API for the key, and allow your dev origin
# (http://localhost:4321/*) plus the workers.dev origin you deploy to.
PUBLIC_GOOGLE_MAPS_API_KEY=

# Shared passphrase for encrypting member contacts (private_contacts in place
# frontmatter). Loaded by `pnpm encrypt:member-contacts` / `make encrypt`, and
# by `pnpm build` / `make build` before Astro runs. Not exposed to the browser.
MEMBER_CONTACTS_PASSWORD=
